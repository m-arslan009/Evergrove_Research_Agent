# Copy to .env and edit. Never commit .env — it is in .gitignore.
# Every value here has a working default in src/evergrove_agent/config.py, so an
# empty .env is a valid, fully local, $0 configuration.

# --- Local model runtime (Ollama) --------------------------------------------------
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL=qwen3:4b
# Without this the model unloads between calls and reloads from disk every time.
# Also set OLLAMA_KEEP_ALIVE=60m in your shell so the server agrees.
LOCAL_KEEP_ALIVE=60m
NUM_CTX=4096

# --- Hosted model runtime (Google AI Studio, free tier, opt-in) ---------------------
# Free key, no credit card: https://aistudio.google.com/apikey
# Leave blank to stay fully local. Enabling hosted sends task text to Google.
GOOGLE_API_KEY=
# Free-tier model ids change. gemini-2.5-flash was the earlier default and now 404s for
# newly issued keys ("no longer available to new users"), so confirm against your console.
HOSTED_MODEL=gemini-3.6-flash

# --- Which provider serves which role: local | hosted ------------------------------
# `local` is the committed default; it is what makes the $0-local claim true.
SUPERVISOR_PROVIDER=local
RESEARCHER_PROVIDER=local
APPRAISER_PROVIDER=local
TEMPERATURE=0.0

# --- Search (consumed from Day 2) ---------------------------------------------------
# fixture | serpapi | academic | ddgs. `fixture` replays recorded results and costs
# no quota, which is why it is the default for tests and development.
SEARCH_BACKEND=fixture
# Free tier, 250 searches/month: https://serpapi.com/
SERPAPI_API_KEY=
# Live searches allowed per calendar month; 200 of 250 leaves 50 in reserve.
MONTHLY_SEARCH_BUDGET=200
# Per-request timeout for a live search backend (serpapi, academic), in seconds.
SEARCH_TIMEOUT_S=15

# --- Per-run budgets (sized for a CPU-bound 16 GB machine) --------------------------
MAX_HOPS=3
MAX_SEARCH_CALLS=3
MAX_FETCH_CALLS=4
MAX_SOURCES_KEPT=3
MAX_MODEL_CALLS=10
SOURCE_EXCERPT_CHARS=3000
# Ceiling on the extracted text cached per source. A safety bound, not a reading budget:
# the cache must stay large enough for a later question to find different passages in it.
MAX_SOURCE_TEXT_CHARS=200000
MAX_OUTPUT_RETRIES=3
# Largest attachment read_document will open, in bytes (10 MB).
MAX_DOCUMENT_BYTES=10485760
# Largest response body fetch_url will download, in bytes (5 MB). Separate from
# MAX_DOCUMENT_BYTES: a fetched page is not an attachment the user chose.
MAX_FETCH_BYTES=5242880
# Per-request timeout for fetch_url, in seconds. Separate from SEARCH_TIMEOUT_S.
FETCH_TIMEOUT_S=15
# 900 for an all-local run; drop to 180 when every role is hosted.
TOTAL_RUN_TIMEOUT_S=900

# --- Expiry --------------------------------------------------------------------------
CACHE_TTL_DAYS=7
# How long a cached search answers the same query again. Separate from CACHE_TTL_DAYS:
# this is the one that protects the monthly search quota.
SEARCH_CACHE_TTL_DAYS=7
MEMORY_RECALL_MAX_AGE_DAYS=30

# --- Paths ---------------------------------------------------------------------------
# Relative paths resolve against the repository root.
DB_PATH=data/evergrove_agent.sqlite3
# attachment_path must resolve inside this directory (security guard, plan 30).
ALLOWED_ATTACHMENT_DIR=fixtures
# Recorded search responses the `fixture` backend replays.
SEARCH_FIXTURE_DIR=fixtures/search
